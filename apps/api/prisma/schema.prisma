generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CustomerType {
  PERSON
  COMPANY
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  LABOR
}

enum InvoiceDraftStatus {
  DRAFT
  READY
  CONVERTED
}

enum InvoiceStatus {
  ISSUED
  RECTIFIED
  CANCELLED
}

enum FiscalEnvironment {
  TEST
  PRODUCTION
}

enum FiscalRecordKind {
  ALTA
  ANULACION
}

enum FiscalRecordState {
  GENERATED
  PENDING_SUBMISSION
  SUBMITTED
  ACCEPTED
  ACCEPTED_WITH_ERRORS
  REJECTED
}

enum FiscalInvoiceType {
  F1
  F2
  F3
  R1
  R2
  R3
  R4
  R5
}

enum FiscalSubmissionState {
  CREATED
  SENDING
  RESPONSE_RECEIVED
  COMPLETED
  TRANSPORT_ERROR
  SOAP_FAULT
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  legalName    String
  tradeName    String?
  taxId        String   @unique
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  province     String
  countryCode  String   @default("ES") @db.Char(2)
  phone        String?
  email        String?
  website      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers          Customer[]
  vehicles           Vehicle[]
  catalogItems       CatalogItem[]
  invoiceDrafts      InvoiceDraft[]
  invoiceSeries      InvoiceSeries[]
  invoices           Invoice[]
  fiscalChains       FiscalChain[]
  fiscalRecords      FiscalRecord[]
  fiscalSubmissions  FiscalSubmission[]
  demoDocumentSeries DemoDocumentSeries[]
  demoDocuments      DemoDocument[]

  @@map("companies")
}

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  type         CustomerType @default(PERSON)
  legalName    String
  tradeName    String?
  taxId        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  province     String?
  countryCode  String       @default("ES") @db.Char(2)
  phone        String?
  email        String?
  notes        String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicles      Vehicle[]
  invoiceDrafts InvoiceDraft[]
  invoices      Invoice[]

  @@unique([companyId, taxId])
  @@index([companyId])
  @@index([companyId, legalName])
  @@map("customers")
}

model Vehicle {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Uuid
  customerId         String   @db.Uuid
  registrationNumber String
  brand              String
  model              String
  version            String?
  vin                String?
  currentMileage     Int?
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDrafts InvoiceDraft[]
  invoices      Invoice[]

  @@unique([companyId, registrationNumber])
  @@unique([companyId, vin])
  @@index([companyId])
  @@index([customerId])
  @@map("vehicles")
}

model CatalogItem {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  type           CatalogItemType
  code           String?         @db.VarChar(50)
  name           String          @db.VarChar(200)
  description    String?
  unit           String          @default("UD") @db.VarChar(20)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(21.00) @db.Decimal(5, 2)
  trackInventory Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  draftLines   InvoiceDraftLine[]
  invoiceLines InvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, name])
  @@map("catalog_items")
}

model InvoiceDraft {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @db.Uuid
  customerId   String             @db.Uuid
  vehicleId    String?            @db.Uuid
  status       InvoiceDraftStatus @default(DRAFT)
  readyAt      DateTime?
  convertedAt  DateTime?
  currencyCode String             @default("EUR") @db.Char(3)
  notes        String?
  subtotal     Decimal            @default(0.00) @db.Decimal(14, 2)
  taxAmount    Decimal            @default(0.00) @db.Decimal(14, 2)
  totalAmount  Decimal            @default(0.00) @db.Decimal(14, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lines        InvoiceDraftLine[]
  invoice      Invoice?
  demoDocument DemoDocument?

  @@index([companyId, status])
  @@index([customerId])
  @@index([vehicleId])
  @@map("invoice_drafts")
}

model InvoiceDraftLine {
  id             String          @id @default(uuid()) @db.Uuid
  invoiceDraftId String          @db.Uuid
  catalogItemId  String?         @db.Uuid
  position       Int
  type           CatalogItemType
  code           String?         @db.VarChar(50)
  description    String          @db.VarChar(500)
  quantity       Decimal         @db.Decimal(12, 3)
  unit           String          @db.VarChar(20)
  unitPrice      Decimal         @db.Decimal(12, 2)
  discountRate   Decimal         @default(0.00) @db.Decimal(5, 2)
  taxRate        Decimal         @db.Decimal(5, 2)
  netAmount      Decimal         @db.Decimal(14, 2)
  taxAmount      Decimal         @db.Decimal(14, 2)
  totalAmount    Decimal         @db.Decimal(14, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  invoiceDraft InvoiceDraft @relation(fields: [invoiceDraftId], references: [id], onDelete: Cascade)
  catalogItem  CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([invoiceDraftId, position])
  @@index([catalogItemId])
  @@map("invoice_draft_lines")
}

model InvoiceSeries {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  code       String   @db.VarChar(20)
  year       Int
  nextNumber Int      @default(1)
  padding    Int      @default(6)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([companyId, code, year])
  @@index([companyId, isActive])
  @@map("invoice_series")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  seriesId      String        @db.Uuid
  sourceDraftId String        @unique @db.Uuid
  customerId    String        @db.Uuid
  vehicleId     String?       @db.Uuid
  status        InvoiceStatus @default(ISSUED)

  number     Int
  fullNumber String    @db.VarChar(50)
  issuedAt   DateTime  @default(now())
  dueAt      DateTime?

  currencyCode String  @default("EUR") @db.Char(3)
  notes        String?

  sellerLegalName    String  @db.VarChar(200)
  sellerTradeName    String? @db.VarChar(200)
  sellerTaxId        String  @db.VarChar(20)
  sellerAddressLine1 String  @db.VarChar(250)
  sellerAddressLine2 String? @db.VarChar(250)
  sellerPostalCode   String  @db.VarChar(10)
  sellerCity         String  @db.VarChar(100)
  sellerProvince     String  @db.VarChar(100)
  sellerCountryCode  String  @db.Char(2)
  sellerPhone        String? @db.VarChar(30)
  sellerEmail        String? @db.VarChar(254)
  sellerWebsite      String? @db.VarChar(255)

  customerLegalName    String  @db.VarChar(200)
  customerTradeName    String? @db.VarChar(200)
  customerTaxId        String? @db.VarChar(20)
  customerAddressLine1 String? @db.VarChar(250)
  customerAddressLine2 String? @db.VarChar(250)
  customerPostalCode   String? @db.VarChar(10)
  customerCity         String? @db.VarChar(100)
  customerProvince     String? @db.VarChar(100)
  customerCountryCode  String  @db.Char(2)
  customerPhone        String? @db.VarChar(30)
  customerEmail        String? @db.VarChar(254)

  vehicleRegistrationNumber String? @db.VarChar(20)
  vehicleBrand              String? @db.VarChar(100)
  vehicleModel              String? @db.VarChar(100)
  vehicleVersion            String? @db.VarChar(100)
  vehicleVin                String? @db.VarChar(50)
  vehicleMileage            Int?

  subtotal    Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  series        InvoiceSeries  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  sourceDraft   InvoiceDraft   @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  fiscalRecords FiscalRecord[]

  @@unique([seriesId, number])
  @@unique([companyId, fullNumber])
  @@index([companyId, issuedAt])
  @@index([customerId])
  @@index([vehicleId])
  @@map("invoices")
}

model InvoiceLine {
  id            String          @id @default(uuid()) @db.Uuid
  invoiceId     String          @db.Uuid
  catalogItemId String?         @db.Uuid
  position      Int
  type          CatalogItemType
  code          String?         @db.VarChar(50)
  description   String          @db.VarChar(500)
  quantity      Decimal         @db.Decimal(12, 3)
  unit          String          @db.VarChar(20)
  unitPrice     Decimal         @db.Decimal(12, 2)
  discountRate  Decimal         @db.Decimal(5, 2)
  taxRate       Decimal         @db.Decimal(5, 2)
  netAmount     Decimal         @db.Decimal(14, 2)
  taxAmount     Decimal         @db.Decimal(14, 2)
  totalAmount   Decimal         @db.Decimal(14, 2)
  createdAt     DateTime        @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
  @@index([catalogItemId])
  @@map("invoice_lines")
}

model DemoDocumentSeries {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  code       String   @default("DEMO") @db.VarChar(20)
  year       Int
  nextNumber Int      @default(1)
  padding    Int      @default(6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents DemoDocument[]

  @@unique([companyId, code, year])
  @@index([companyId])
  @@map("demo_document_series")
}

model DemoDocument {
  id            String @id @default(uuid()) @db.Uuid
  companyId     String @db.Uuid
  seriesId      String @db.Uuid
  sourceDraftId String @unique @db.Uuid

  number     Int
  fullNumber String   @db.VarChar(50)
  issuedAt   DateTime @default(now())

  currencyCode String @default("EUR") @db.Char(3)
  snapshot     Json

  qrToken String @unique @db.VarChar(64)
  qrUrl   String @db.VarChar(500)

  fiscalHashInput       String
  fiscalHash            String @db.Char(64)
  generatedAtWithOffset String @db.VarChar(35)

  xmlPreview String
  xmlHash    String  @db.Char(64)
  pdfHash    String? @db.Char(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  series      DemoDocumentSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  sourceDraft InvoiceDraft       @relation(fields: [sourceDraftId], references: [id], onDelete: Restrict)

  @@unique([seriesId, number])
  @@unique([companyId, fullNumber])
  @@index([companyId, issuedAt])
  @@map("demo_documents")
}

model FiscalChain {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  environment        FiscalEnvironment
  installationNumber String            @default("1") @db.VarChar(50)
  nextSequence       Int               @default(1)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  records     FiscalRecord[]
  submissions FiscalSubmission[]

  @@unique([companyId, environment, installationNumber])
  @@index([companyId, environment, isActive])
  @@map("fiscal_chains")
}

model FiscalRecord {
  id          String            @id @default(uuid()) @db.Uuid
  chainId     String            @db.Uuid
  companyId   String            @db.Uuid
  invoiceId   String            @db.Uuid
  sequence    Int
  kind        FiscalRecordKind
  state       FiscalRecordState @default(GENERATED)
  invoiceType FiscalInvoiceType

  issuerTaxId   String @db.VarChar(20)
  invoiceNumber String @db.VarChar(60)
  invoiceDate   String @db.Char(10)

  totalTaxAmount Decimal @db.Decimal(14, 2)
  totalAmount    Decimal @db.Decimal(14, 2)

  previousRecordId      String? @unique @db.Uuid
  previousInvoiceNumber String? @db.VarChar(60)
  previousInvoiceDate   String? @db.Char(10)
  previousHash          String? @db.Char(64)

  hashInput String
  hash      String @db.Char(64)

  generatedAt           DateTime
  generatedAtWithOffset String   @db.VarChar(35)

  qrUrl String?

  aeatCsv              String? @db.VarChar(100)
  aeatStatusCode       String? @db.VarChar(50)
  aeatErrorCode        String? @db.VarChar(50)
  aeatErrorDescription String?

  submittedAt DateTime?
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chain   FiscalChain @relation(fields: [chainId], references: [id], onDelete: Restrict)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  previousRecord FiscalRecord? @relation("FiscalRecordSequence", fields: [previousRecordId], references: [id], onDelete: Restrict)

  nextRecord FiscalRecord? @relation("FiscalRecordSequence")

  submissionItems FiscalSubmissionItem[]

  @@unique([chainId, sequence])
  @@unique([chainId, hash])
  @@index([companyId, state])
  @@index([invoiceId, kind])
  @@index([chainId, createdAt])
  @@map("fiscal_records")
}

model FiscalSubmission {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @db.Uuid
  chainId            String                @db.Uuid
  environment        FiscalEnvironment
  installationNumber String                @db.VarChar(100)
  state              FiscalSubmissionState @default(CREATED)

  endpoint    String @db.VarChar(500)
  requestXml  String
  requestHash String @db.Char(64)

  responseXml String?
  httpStatus  Int?

  globalStatus String? @db.VarChar(50)
  aeatCsv      String? @db.VarChar(100)

  presenterTaxId  String?   @db.VarChar(20)
  presentationAt  DateTime?
  presentationRaw String?   @db.VarChar(35)
  waitSeconds     Int?

  soapFaultCode    String? @db.VarChar(100)
  soapFaultMessage String?
  transportError   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?
  nextRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chain   FiscalChain            @relation(fields: [chainId], references: [id], onDelete: Restrict)
  items   FiscalSubmissionItem[]

  @@index([companyId, state])
  @@index([chainId, createdAt])
  @@index([state, nextRetryAt])
  @@map("fiscal_submissions")
}

model FiscalSubmissionItem {
  id             String @id @default(uuid()) @db.Uuid
  submissionId   String @db.Uuid
  fiscalRecordId String @db.Uuid

  position      Int
  attemptNumber Int
  operation     FiscalRecordKind

  resultState FiscalRecordState?

  aeatStatusCode       String? @db.VarChar(50)
  aeatErrorCode        String? @db.VarChar(50)
  aeatErrorDescription String?

  duplicateState         String? @db.VarChar(50)
  duplicateIssuerTaxId   String? @db.VarChar(20)
  duplicateInvoiceNumber String? @db.VarChar(60)
  duplicateInvoiceDate   String? @db.Char(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission   FiscalSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  fiscalRecord FiscalRecord     @relation(fields: [fiscalRecordId], references: [id], onDelete: Restrict)

  @@unique([submissionId, position])
  @@unique([submissionId, fiscalRecordId])
  @@unique([fiscalRecordId, attemptNumber])
  @@index([fiscalRecordId, createdAt])
  @@map("fiscal_submission_items")
}
