generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CustomerType {
  PERSON
  COMPANY
}

enum CatalogItemType {
  PRODUCT
  SERVICE
  LABOR
}

enum InvoiceDraftStatus {
  DRAFT
  READY
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  legalName    String
  tradeName    String?
  taxId        String   @unique
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  province     String
  countryCode  String   @default("ES") @db.Char(2)
  phone        String?
  email        String?
  website      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers     Customer[]
  vehicles      Vehicle[]
  catalogItems  CatalogItem[]
  invoiceDrafts InvoiceDraft[]

  @@map("companies")
}

model Customer {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  type         CustomerType @default(PERSON)
  legalName    String
  tradeName    String?
  taxId        String?
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  province     String?
  countryCode  String       @default("ES") @db.Char(2)
  phone        String?
  email        String?
  notes        String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicles      Vehicle[]
  invoiceDrafts InvoiceDraft[]

  @@unique([companyId, taxId])
  @@index([companyId])
  @@index([companyId, legalName])
  @@map("customers")
}

model Vehicle {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Uuid
  customerId         String   @db.Uuid
  registrationNumber String
  brand              String
  model              String
  version            String?
  vin                String?
  currentMileage     Int?
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceDrafts InvoiceDraft[]

  @@unique([companyId, registrationNumber])
  @@unique([companyId, vin])
  @@index([companyId])
  @@index([customerId])
  @@map("vehicles")
}

model CatalogItem {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  type           CatalogItemType
  code           String?         @db.VarChar(50)
  name           String          @db.VarChar(200)
  description    String?
  unit           String          @default("UD") @db.VarChar(20)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxRate        Decimal         @default(21.00) @db.Decimal(5, 2)
  trackInventory Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  draftLines InvoiceDraftLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, name])
  @@map("catalog_items")
}

model InvoiceDraft {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @db.Uuid
  customerId   String             @db.Uuid
  vehicleId    String?            @db.Uuid
  status       InvoiceDraftStatus @default(DRAFT)
  currencyCode String             @default("EUR") @db.Char(3)
  notes        String?
  subtotal     Decimal            @default(0.00) @db.Decimal(14, 2)
  taxAmount    Decimal            @default(0.00) @db.Decimal(14, 2)
  totalAmount  Decimal            @default(0.00) @db.Decimal(14, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  lines    InvoiceDraftLine[]

  @@index([companyId, status])
  @@index([customerId])
  @@index([vehicleId])
  @@map("invoice_drafts")
}

model InvoiceDraftLine {
  id             String          @id @default(uuid()) @db.Uuid
  invoiceDraftId String          @db.Uuid
  catalogItemId  String?         @db.Uuid
  position       Int
  type           CatalogItemType
  code           String?         @db.VarChar(50)
  description    String          @db.VarChar(500)
  quantity       Decimal         @db.Decimal(12, 3)
  unit           String          @db.VarChar(20)
  unitPrice      Decimal         @db.Decimal(12, 2)
  discountRate   Decimal         @default(0.00) @db.Decimal(5, 2)
  taxRate        Decimal         @db.Decimal(5, 2)
  netAmount      Decimal         @db.Decimal(14, 2)
  taxAmount      Decimal         @db.Decimal(14, 2)
  totalAmount    Decimal         @db.Decimal(14, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  invoiceDraft InvoiceDraft @relation(fields: [invoiceDraftId], references: [id], onDelete: Cascade)
  catalogItem  CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([invoiceDraftId, position])
  @@index([catalogItemId])
  @@map("invoice_draft_lines")
}
