generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  legalName    String
  tradeName    String?
  taxId        String   @unique
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  province     String
  countryCode  String   @default("ES") @db.Char(2)
  phone        String?
  email        String?
  website      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("companies")
}
